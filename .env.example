# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated CORS origins (mobile app / admin console). Use * for dev only.
CORS_ORIGINS=*

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ona

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# Seed a first admin on boot (optional, dev convenience)
SEED_ADMIN_EMAIL=admin@ona.health
SEED_ADMIN_PASSWORD=changeme123

# ── StarkNet ImpactRegistry v2 ──────────────────────────────────────────────
STARKNET_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
STARKNET_NETWORK=SN_SEPOLIA
STARKNET_CONTRACT_ADDRESS=0x60992a96095dded8c0b44485cf793bff9692e228cb55730f5e92b2351405289
# Owner account that is allowed to anchor + register facilities.
STARKNET_OWNER_ADDRESS=0x014e9e2266c735c78e602ee828a50971e4aaa78b487fe47fc998444645b8e2bd
# NEVER commit the real key. Provide via secret manager in production.
STARKNET_OWNER_PRIVATE_KEY=0x0
# Set false to run the API without touching the chain (screenings stay 'pending').
BLOCKCHAIN_ENABLED=true
# Anchor retry worker cron (seconds between sweeps of pending/failed records).
BLOCKCHAIN_RETRY_INTERVAL_SEC=30

# ── Uploads ─────────────────────────────────────────────────────────────────
# gridfs (default) stores images in MongoDB. Max upload size in bytes.
UPLOAD_MAX_BYTES=10485760
